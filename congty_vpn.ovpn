client
dev tun
proto udp

# THAY BẰNG IP MÁY ẢO HIỆN TẠI CỦA BẠN 
remote 10.0.134.153 1195

resolv-retry infinite
nobind
persist-key
persist-tun
cipher AES-256-GCM
auth SHA256
key-direction 1
remote-cert-tls server

# Lệnh này bật hộp thoại đòi nhập Username/Password khi kết nối
auth-user-pass

verb 3

